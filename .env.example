# .env.example - 环境变量模板（中文注释版）
# 使用方法：复制为 .env 并填入真实值，切勿提交 .env 到版本库

# ===== DeepSeek LLM 配置 =====
DEEPSEEK_API_KEY=your_deepseek_key_here       # DeepSeek API Key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1  # DeepSeek API 地址
LLM_MODEL=deepseek-v4-flash                # LLM 模型名称

# ===== 邮件服务 (Resend) =====
RESEND_API_KEY=your_resend_api_key_here     # Resend API Key（需到 resend.com 申请）
EMAIL_FROM=your_email@example.com              # 发件邮箱地址（需在 Resend 验证域名/邮箱）
EMAIL_FROM_NAME=AI Sales Outreach             # 可选：发件人显示名称
TEST_EMAIL=test@example.com                  # 测试收件人（Resend 测试模式限制）

# ===== 企业微信 (Webhook) =====
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
# 企业微信群机器人 Webhook URL（在企业微信管理后台添加机器人获取）

# ===== 钉钉 (Webhook) =====
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your_token_here
# 钉钉群机器人 Webhook URL（在钉钉群聊中添加机器人获取）

# ===== Redis 配置 =====
REDIS_HOST=localhost          # Redis 主机地址（Docker 部署时使用服务名 redis）
REDIS_PORT=6379            # Redis 端口
REDIS_DB=0                 # Redis 数据库编号

# ===== 可选：其他 LLM 提供商（按需启用） =====
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# QWEN_API_BASE=https://dashscope.aliyuncs.com/v2/compatible-mode/v1
# QWEN_API_KEY=your_qwen_key_here
